---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
interface Props {
    title: string;
    description?: string;
}
const { title, description = "Darlingson Makuwila, software engineer in Blantyre, Malawi building backend systems and data-driven applications with C#/.NET and Laravel at Nico Technologies." } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = new URL("/og-image.svg", Astro.site);
const isHome = path === "/";
const isProjects = path.startsWith("/projects");
const navBase = "text-[13px] font-semibold tracking-widest uppercase";
const navActive = `${navBase} text-primary border-b-2 border-primary pb-1`;
const navInactive = `${navBase} text-on-surface-variant hover:text-primary transition-colors`;
const mobileBase = "text-sm font-semibold uppercase tracking-wide";
const mobileActive = `${mobileBase} text-primary`;
const mobileInactive = `${mobileBase} text-on-surface-variant`;
---

<!doctype html>
<html lang="en" class="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={canonical} />
        <meta name="description" content={description} />
        <meta name="robots" content="index, follow" />
        <meta name="theme-color" content="#0b0f17" />
        <meta name="generator" content={Astro.generator} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Darlingson Makuwila" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
        <title>{title}</title>
        <Analytics />

        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Person",
            "name": "Darlingson Makuwila",
            "url": Astro.site,
            "jobTitle": "Software Developer",
            "description": description,
            "address": {
                "@type": "PostalAddress",
                "addressLocality": "Blantyre",
                "addressCountry": "MW"
            },
            "alumniOf": {
                "@type": "CollegeOrUniversity",
                "name": "Malawi University of Business and Applied Sciences"
            },
            "worksFor": {
                "@type": "Organization",
                "name": "Nico Technologies"
            },
            "sameAs": [
                "https://github.com/darlingson",
                "https://www.linkedin.com/in/darlingsonm",
                "https://www.instagram.com/@darlingson_m"
            ]
        })} />
    </head>
    <body class="min-h-screen flex flex-col bg-background text-on-surface">
        <header class="w-full sticky top-0 z-50 bg-background/80 backdrop-blur-md border-b border-outline-variant/30">
            <nav class="flex justify-between items-center max-w-[1200px] mx-auto px-6 md:px-8 py-4">
                <a href="/" class="font-display font-semibold text-[22px] tracking-tight text-on-background">Darlingson Makuwila</a>
                <div class="hidden md:flex items-center gap-8">
                    <a href="/" class={isHome ? navActive : navInactive}>Home</a>
                    <a href="/projects" class={isProjects ? navActive : navInactive}>Projects</a>
                    <a href="/contact" class="ml-2 px-6 py-2.5 bg-primary text-on-primary rounded-lg text-[13px] font-semibold tracking-wide hover:bg-primary-hover transition-colors">Contact</a>
                </div>
                <button id="menu-btn" class="md:hidden text-on-background p-2" aria-label="Toggle Menu">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /></svg>
                </button>
            </nav>
            <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-background border-b border-outline-variant/30 flex flex-col p-6 gap-4">
                <a href="/" class={isHome ? mobileActive : mobileInactive}>Home</a>
                <a href="/projects" class={isProjects ? mobileActive : mobileInactive}>Projects</a>
                <a href="/contact" class="mt-2 px-6 py-3 bg-primary text-on-primary rounded-lg text-sm font-semibold text-center">Contact</a>
            </div>
        </header>

        <main class="flex-grow">
            <slot />
        </main>

        <footer class="w-full border-t border-outline-variant/30 bg-background">
            <div class="max-w-[1200px] mx-auto px-6 md:px-8 py-12 flex flex-col md:flex-row justify-between gap-8">
                <div class="space-y-3">
                    <div class="font-display font-semibold text-lg">Darlingson Makuwila</div>
                    <p class="text-sm text-on-surface-variant max-w-sm leading-relaxed">© 2026 Darlingson Makuwila · Blantyre, Malawi</p>
                </div>
                <div class="flex flex-wrap gap-6 text-[13px] font-semibold tracking-wide uppercase text-on-surface-variant">
                    <a href="https://github.com/darlingson" target="_blank" class="hover:text-primary transition-colors">GitHub</a>
                    <a href="https://www.linkedin.com/in/darlingsonm" target="_blank" class="hover:text-primary transition-colors">LinkedIn</a>
                    <a href="https://www.instagram.com/darlingson_m" target="_blank" class="hover:text-primary transition-colors">Instagram</a>
                    <a href="/contact" class="hover:text-primary transition-colors">Contact</a>
                    <a href="/projects" class="hover:text-primary transition-colors">Projects</a>
                </div>
            </div>
        </footer>

        <script>
            const btn = document.getElementById("menu-btn");
            const menu = document.getElementById("mobile-menu");
            btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
        </script>
    </body>
</html>
