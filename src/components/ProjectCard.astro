---
interface Props {
  title: string;
  description: string;
  tech: string;
  status: string;
  tag: string;
  fileName: string;
}
const { title, description, tech, status, tag } = Astro.props;
---

<div class="group bg-surface border border-outline-variant/30 rounded-2xl p-8 card-shadow hover:border-primary/20 transition-colors flex flex-col h-full">
  <div class="flex items-center gap-2 mb-5">
    <span class="px-3 py-1 bg-surface-container rounded-full text-[11px] font-semibold tracking-widest uppercase text-on-surface-variant">{tag}</span>
    <span class:list={["px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide uppercase border", status === 'PRODUCTION' ? "bg-green-50 text-green-700 border-green-200" : "bg-amber-50 text-amber-700 border-amber-200"]}>{status}</span>
  </div>
  <h3 class="font-display font-semibold text-2xl mb-3 text-on-background group-hover:text-primary transition-colors">{title}</h3>
  <p class="text-[15px] leading-relaxed text-on-surface-variant mb-6 flex-grow">{description}</p>
  <div class="flex items-center justify-between pt-6 border-t border-outline-variant/30">
    <div>
      <p class="text-[11px] font-semibold tracking-widest uppercase text-on-surface-variant/60">Build</p>
      <p class="text-xs font-semibold tracking-wide uppercase text-on-background mt-1">{tech}</p>
    </div>
    <a href="/projects" class="text-sm font-semibold text-primary flex items-center gap-1.5 hover:gap-2 transition-all">View <span>→</span></a>
  </div>
</div>
