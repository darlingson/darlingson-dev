---
interface Props {
  title: string;
  tags: string[];
  description: string;
  stability: string;
  url?: string;
}
const { title, tags, description, stability, url } = Astro.props;
const isLive = stability.toLowerCase().includes("production") || stability.toLowerCase().includes("live");
const statusLabel = isLive ? "Production" : "In Development";
---

<div class="bg-surface border border-outline-variant/30 rounded-2xl p-8 card-shadow hover:border-primary/20 transition-colors flex flex-col h-full">
  <div class="flex items-center justify-between gap-3 mb-5">
    <div class="flex flex-wrap gap-1.5">
      {tags.map(tag => <span class="text-[10px] px-2.5 py-1 bg-surface-container rounded-full font-semibold tracking-wide uppercase text-on-surface-variant">{tag}</span>)}
    </div>
    <span class:list={["px-2.5 py-1 rounded-full text-[11px] font-semibold tracking-wide uppercase border shrink-0", isLive ? "bg-primary/15 text-primary border-primary/30" : "bg-amber/15 text-amber border-amber/30"]}>{statusLabel}</span>
  </div>
  <h3 class="font-display font-semibold text-2xl mb-3 text-on-background">{title}</h3>
  <p class="text-[15px] leading-relaxed text-on-surface-variant mb-6 flex-grow">{description}</p>
  {url && (
    <a href={url} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-primary flex items-center gap-1.5 hover:gap-2 transition-all self-start">Visit <span>→</span></a>
  )}
</div>
