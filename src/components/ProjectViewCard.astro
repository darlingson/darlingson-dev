---
interface Props {
  title: string;
  fileName: string;
  tags: string[];
  description: string;
  branch: string;
  stability: string;
  metaLabel: string;
  metaValue: string;
  action: string;
}
const { title, tags, description, branch, stability, metaLabel, metaValue } = Astro.props;
---

<div class="bg-surface border border-outline-variant/30 rounded-2xl overflow-hidden flex flex-col card-shadow">
  <div class="px-6 py-3 flex justify-between items-center border-b border-outline-variant/30 bg-surface-low">
    <div class="flex gap-1.5">
      <div class="w-2.5 h-2.5 rounded-full bg-red-400/60"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-amber-400/60"></div>
      <div class="w-2.5 h-2.5 rounded-full bg-green-400/60"></div>
    </div>
    <span class="text-[10px] font-semibold tracking-widest uppercase text-on-surface-variant/50">{branch}</span>
  </div>
  <div class="p-6 md:p-7 flex flex-col flex-grow">
    <div class="flex justify-between items-start gap-4 mb-4">
      <h3 class="font-display font-semibold text-xl md:text-2xl text-on-background">{title}</h3>
      <div class="flex flex-wrap gap-1.5 justify-end shrink-0">
        {tags.map(tag => <span class="text-[10px] px-2.5 py-1 bg-surface-container rounded-full font-semibold tracking-wide uppercase text-on-surface-variant">{tag}</span>)}
      </div>
    </div>
    <p class="text-sm leading-relaxed text-on-surface-variant mb-6 flex-grow">{description}</p>
    <div class="grid grid-cols-3 gap-4 text-xs pt-5 border-t border-outline-variant/30">
      <div><p class="text-[11px] font-semibold tracking-widest uppercase text-on-surface-variant/50 mb-1">Branch</p><p class="font-semibold text-primary">{branch}</p></div>
      <div><p class="text-[11px] font-semibold tracking-widest uppercase text-on-surface-variant/50 mb-1">Stability</p><p class:list={["font-semibold", stability === 'PRODUCTION' ? "text-green-700" : "text-amber-700"]}>{stability}</p></div>
      <div class="text-right"><p class="text-[11px] font-semibold tracking-widest uppercase text-on-surface-variant/50 mb-1">{metaLabel}</p><p class="font-semibold text-on-background">{metaValue}</p></div>
    </div>
  </div>
</div>
