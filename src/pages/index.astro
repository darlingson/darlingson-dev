---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactCard from "../components/ContactCard.astro";
const projects = [
	{
		title: "Fast Budget",
		description: "A budgeting tool for everyday use — expense tracking and goal-setting, kept simple enough that I actually open it. Built with TypeScript.",
		tech: "TypeScript",
		status: "Production",
		tag: "FinTech",
		fileName: "fast_budget.ts",
	},
	{
		title: "Mpira Analytics",
		description: "Analytics for Malawian football — player stats and match data, visualized. Still a work in progress. Built with Vue.",
		tech: "Vue",
		status: "In Development",
		tag: "Data Viz",
		fileName: "mpira_analytics.vue",
	},
];
---

<Layout title="Darlingson Makuwila | Software Engineer" description="Full-stack developer moving into backend engineering, based in Blantyre, Malawi. Currently a developer at Nico Technologies working with Spring Boot and Vue/Nuxt. Building Fast Budget and Mpira Analytics.">
	<Hero />

	<!-- Who I Am -->
	<section class="bg-surface border-y border-outline-variant/30">
		<div class="max-w-[1200px] mx-auto px-6 md:px-8 py-16 md:py-20">
			<div class="max-w-3xl">
				<p class="text-xs font-semibold tracking-[0.15em] uppercase text-primary mb-3">Who I Am</p>
				<h2 class="font-display font-semibold text-[28px] md:text-[32px] leading-tight text-on-background mb-6">From full-stack to backend-focused.</h2>
				<div class="space-y-4 text-[15px] leading-relaxed text-on-surface-variant">
					<p>I started as a full-stack developer — Laravel on the backend, React, Vue, Next.js and Nuxt.js on the front — and I'm now moving toward backend engineering with Spring Boot and ASP.NET. I studied Management Information Systems at the Malawi University of Business and Applied Sciences, and I currently work as a developer at Nico Technologies, building backend and frontend systems across a few different products.</p>
					<p>Outside work I build my own things — a budgeting app I actually use daily, and a football analytics project for Malawian football that's still in progress.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Core Competencies -->
	<section class="max-w-[1200px] mx-auto px-6 md:px-8 py-16 md:py-20">
		<div class="text-center mb-12">
			<h2 class="font-display font-semibold text-[28px] text-on-background mb-3">Core Competencies</h2>
			<div class="w-14 h-1 bg-primary mx-auto rounded-full"></div>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-4xl mx-auto">
			<div class="group p-7 bg-surface-low border border-outline-variant/30 rounded-2xl hover:border-primary/40 transition-colors">
				<div class="w-11 h-11 flex items-center justify-center bg-primary/10 rounded-xl mb-5 text-primary font-mono text-lg">BE</div>
				<h4 class="font-display font-semibold text-lg mb-2 text-on-background">Backend Engineering</h4>
				<p class="text-sm leading-relaxed text-on-surface-variant">Spring Boot and ASP.NET, moving from full-stack into backend-focused work.</p>
			</div>
			<div class="group p-7 bg-surface-low border border-outline-variant/30 rounded-2xl hover:border-primary/40 transition-colors">
				<div class="w-11 h-11 flex items-center justify-center bg-primary/10 rounded-xl mb-5 text-primary font-mono text-lg">FS</div>
				<h4 class="font-display font-semibold text-lg mb-2 text-on-background">Full-Stack Development</h4>
				<p class="text-sm leading-relaxed text-on-surface-variant">Laravel, React, Vue, Next.js, Nuxt.js.</p>
			</div>
		</div>
	</section>

	<!-- Selected Projects -->
	<section id="projects" class="bg-surface border-y border-outline-variant/30">
		<div class="max-w-[1200px] mx-auto px-6 md:px-8 py-16 md:py-20">
			<div class="flex justify-between items-end mb-10">
				<div>
					<p class="text-xs font-semibold tracking-[0.15em] uppercase text-primary mb-2">Portfolio</p>
					<h2 class="font-display font-semibold text-[28px] text-on-background">Selected Projects</h2>
				</div>
				<a href="/projects" class="hidden md:flex items-center gap-2 text-sm font-semibold text-primary hover:gap-3 transition-all">View All Projects <span>→</span></a>
			</div>
			<div class="grid md:grid-cols-2 gap-6">
				{projects.map((project) => <ProjectCard {...project} />)}
			</div>
			<div class="md:hidden mt-6 text-center"><a href="/projects" class="text-sm font-semibold text-primary">View All Projects →</a></div>
		</div>
	</section>

	<ContactCard />
</Layout>
