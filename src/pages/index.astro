---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ContactCard from "../components/ContactCard.astro";
const projects = [
	{
		title: "Fast Budget",
		description: "A lightweight budgeting tool for quick expense planning. Designed for offline-first use and optimized for low-data environments. Built with React.",
		tech: "React",
		status: "Production",
		tag: "FinTech",
		fileName: "fast_budget.ts",
		url: "https://fast-budget-eight.vercel.app",
	},
	{
		title: "Financial Overflow",
		description: "Analytics for the Malawi Stock Exchange: structuring financial data for publicly listed companies and building analytics around it. Built with Next.js and Postgres.",
		tech: "Next.js · Postgres",
		status: "Production",
		tag: "Finance",
		fileName: "financial_overflow.py",
		url: "https://financial-overflow.vercel.app",
	},
	{
		title: "Mpira Analytics",
		description: "Analytics for Malawian football: player stats and match data, visualized. Still a work in progress. Built with Vue.",
		tech: "Vue",
		status: "In Development",
		tag: "Data Viz",
		fileName: "mpira_analytics.vue",
		url: "https://mpira-analytics.vercel.app",
	},
	{
		title: "Malawi Recipes",
		description: "A mobile-friendly app for discovering authentic Malawian recipes, aimed at preserving culinary heritage and promoting local cuisine. Built with Flutter.",
		tech: "Flutter",
		status: "In Development",
		tag: "Mobile",
		fileName: "malawi_recipes.dart",
	},
];
---

<Layout title="Darlingson Makuwila | Software Engineer" description="Software engineer building backend systems and data-driven applications, based in Blantyre, Malawi. Currently builds web systems with C#/.NET and Laravel at Nico Technologies. Building Fast Budget, Malawi Recipes, Financial Overflow and Mpira Analytics.">
	<Hero />

	<!-- Who I Am -->
	<section class="bg-surface border-y border-outline-variant/30">
		<div class="max-w-[1200px] mx-auto px-6 md:px-8 py-16 md:py-20">
			<div class="max-w-3xl">
				<p class="text-xs font-semibold tracking-[0.15em] uppercase text-primary mb-3">Who I Am</p>
				<h2 class="font-display font-semibold text-[28px] md:text-[32px] leading-tight text-on-background mb-6">From full-stack to backend-focused.</h2>
				<div class="space-y-4 text-[15px] leading-relaxed text-on-surface-variant">
					<p>I'm a software developer who grew up across the full stack: Laravel and PHP on the backend, React, Vue, Next.js and Nuxt.js on the front, and now spend most of my time on backend systems with C# (ASP.NET) and Spring Boot. I studied Management Information Systems at the Malawi University of Business and Applied Sciences, and I currently work at Nico Technologies building web systems for customers across the Nico Group.</p>
					<p>Outside work I build my own products: Fast Budget, a daily-use budgeting app; Malawi Recipes, a mobile app for Malawian cuisine; and Mpira Analytics, football analytics for Malawian football that's still in progress.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Core Competencies -->
	<section class="max-w-[1200px] mx-auto px-6 md:px-8 py-16 md:py-20">
		<div class="text-center mb-12">
			<h2 class="font-display font-semibold text-[28px] text-on-background mb-3">Core Competencies</h2>
			<div class="w-14 h-1 bg-primary mx-auto rounded-full"></div>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
			<div class="group p-7 bg-surface-low border border-outline-variant/30 rounded-2xl hover:border-primary/40 transition-colors">
				<div class="w-11 h-11 flex items-center justify-center bg-primary/10 rounded-xl mb-5 text-primary font-mono text-lg">BE</div>
				<h4 class="font-display font-semibold text-lg mb-2 text-on-background">Backend Engineering</h4>
				<p class="text-sm leading-relaxed text-on-surface-variant">C# (ASP.NET), PHP (Laravel) and Java (Spring Boot). APIs, auth and data-heavy systems.</p>
			</div>
			<div class="group p-7 bg-surface-low border border-outline-variant/30 rounded-2xl hover:border-primary/40 transition-colors">
				<div class="w-11 h-11 flex items-center justify-center bg-primary/10 rounded-xl mb-5 text-primary font-mono text-lg">FS</div>
				<h4 class="font-display font-semibold text-lg mb-2 text-on-background">Frontend &amp; Full-Stack</h4>
				<p class="text-sm leading-relaxed text-on-surface-variant">React, Vue, Next.js and Nuxt.js, plus Blazor for .NET-frontend work.</p>
			</div>
			<div class="group p-7 bg-surface-low border border-outline-variant/30 rounded-2xl hover:border-primary/40 transition-colors">
				<div class="w-11 h-11 flex items-center justify-center bg-primary/10 rounded-xl mb-5 text-primary font-mono text-lg">MB</div>
				<h4 class="font-display font-semibold text-lg mb-2 text-on-background">Mobile App Development</h4>
				<p class="text-sm leading-relaxed text-on-surface-variant">Flutter, with Kotlin/Jetpack Compose and Java for native Android.</p>
			</div>
			<div class="group p-7 bg-surface-low border border-outline-variant/30 rounded-2xl hover:border-primary/40 transition-colors">
				<div class="w-11 h-11 flex items-center justify-center bg-primary/10 rounded-xl mb-5 text-primary font-mono text-lg">AC</div>
				<h4 class="font-display font-semibold text-lg mb-2 text-on-background">Accounting &amp; Systems</h4>
				<p class="text-sm leading-relaxed text-on-surface-variant">MIS background: cost, financial and management accounting for finance and reporting tools.</p>
			</div>
		</div>
	</section>

	<!-- Selected Projects -->
	<section id="projects" class="bg-surface border-y border-outline-variant/30">
		<div class="max-w-[1200px] mx-auto px-6 md:px-8 py-16 md:py-20">
			<div class="flex justify-between items-end mb-10">
				<div>
					<p class="text-xs font-semibold tracking-[0.15em] uppercase text-primary mb-2">Portfolio</p>
					<h2 class="font-display font-semibold text-[28px] text-on-background">Selected Projects</h2>
				</div>
				<a href="/projects" class="hidden md:flex items-center gap-2 text-sm font-semibold text-primary hover:gap-3 transition-all">View All Projects <span>→</span></a>
			</div>
			<div class="grid md:grid-cols-2 gap-6">
				{projects.map((project) => <ProjectCard {...project} />)}
			</div>
			<div class="md:hidden mt-6 text-center"><a href="/projects" class="text-sm font-semibold text-primary">View All Projects →</a></div>
		</div>
	</section>

	<ContactCard />
</Layout>
