---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectViewCard.astro";

const projects = [
    {
        title: "Fast Budget",
        tags: ["FINTECH", "REACT"],
        description: "A lightweight budgeting tool for quick expense planning. Designed for offline-first use and optimized for low-data environments. Built with React.",
        stability: "PRODUCTION",
        url: "https://fast-budget-eight.vercel.app",
    },
    {
        title: "Financial Overflow",
        tags: ["FINANCE", "NEXTJS"],
        description: "Analytics for the Malawi Stock Exchange: structuring financial data for publicly listed companies and building analytics around it. Built with Next.js and Postgres.",
        stability: "PRODUCTION",
        url: "https://financial-overflow.vercel.app",
    },
    {
        title: "Mpira Analytics",
        tags: ["FOOTBALL", "VUE"],
        description: "Analytics for Malawian football: player stats and match data, visualized. Still a work in progress. Built with Vue.",
        stability: "IN_DEVELOPMENT",
        url: "https://mpira-analytics.vercel.app",
    },
    {
        title: "Malawi Recipes",
        tags: ["MOBILE", "FLUTTER"],
        description: "A mobile-friendly app for discovering authentic Malawian recipes, aimed at preserving culinary heritage and promoting local cuisine. Built with Flutter.",
        stability: "IN_DEVELOPMENT",
    },
];

const allTech = [...new Set(projects.flatMap((p) => [...p.tags]))].sort();
---

<Layout title="Darlingson Makuwila | Projects" description="Projects by Darlingson Makuwila: Fast Budget, a daily-use budgeting app built with React, and Mpira Analytics, football analytics for Malawian football built with Vue.">
    <div class="max-w-[1200px] mx-auto px-6 md:px-8 py-12 md:py-16">
        <header class="max-w-3xl mb-10">
            <p class="text-xs font-semibold tracking-[0.15em] uppercase text-primary mb-3">Portfolio</p>
            <h1 class="font-display font-bold text-[36px] md:text-[44px] leading-tight tracking-[-0.02em] text-on-background mb-4">Selected Projects</h1>
            <p class="text-[16px] leading-relaxed text-on-surface-variant">A curated collection of things I've built: from a daily-use budgeting app to a football analytics project. Filtering by technology.</p>
        </header>

        <div class="flex flex-wrap gap-2 mb-10">
            <button class="filter-btn active-filter px-4 py-2 rounded-full text-xs font-semibold tracking-wide uppercase bg-primary text-on-primary border border-primary" data-filter="all">All Systems</button>
            {allTech.map((tech) => <button class="filter-btn px-4 py-2 rounded-full text-xs font-semibold tracking-wide uppercase bg-surface border border-outline-variant/30 text-on-surface-variant hover:border-primary hover:text-primary transition-colors" data-filter={tech}>{tech}</button>)}
        </div>

        <div class="grid md:grid-cols-2 gap-6 mb-16" id="project-grid">
            {projects.map((project) => <div class="project-wrapper transition-all duration-300" data-tech={JSON.stringify([...project.tags])}><ProjectCard {...project} /></div>)}
        </div>

        <div class="bg-surface border border-outline-variant/30 rounded-2xl p-8 grid md:grid-cols-2 gap-10">
            <div>
                <p class="text-[11px] font-semibold tracking-widest uppercase text-primary mb-3">Current Mission</p>
                <p class="text-sm leading-relaxed text-on-surface-variant">Building backend and frontend systems across multiple products at Nico Technologies, with a focus on Spring Boot and Vue/Nuxt.</p>
            </div>
            <div>
                <p class="text-[11px] font-semibold tracking-widest uppercase text-primary mb-3">Availability</p>
                <p class="text-sm leading-relaxed text-on-surface-variant">Open to freelance, contract, and full-time collaborations. Reach out via email.</p>
                <a href="/contact" class="inline-block mt-3 text-sm font-semibold text-primary hover:underline">Get in touch →</a>
            </div>
        </div>
    </div>
</Layout>
<script>
    const buttons = document.querySelectorAll(".filter-btn");
    const projectWrappers = document.querySelectorAll(".project-wrapper");
    buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
            const filter = btn.getAttribute("data-filter");
            buttons.forEach((b) => {
                b.classList.remove("bg-primary","text-on-primary","border-primary");
                b.classList.add("bg-surface","text-on-surface-variant","border-outline-variant/30");
            });
            btn.classList.add("bg-primary","text-on-primary","border-primary");
            btn.classList.remove("bg-surface","text-on-surface-variant","border-outline-variant/30");
            projectWrappers.forEach((wrapper) => {
                const techStack = JSON.parse(wrapper.getAttribute("data-tech") || "[]");
                if (filter === "all" || techStack.includes(filter)) {
                    (wrapper as HTMLElement).style.display = "block";
                    setTimeout(() => ((wrapper as HTMLElement).style.opacity = "1"), 10);
                } else {
                    (wrapper as HTMLElement).style.opacity = "0";
                    setTimeout(() => ((wrapper as HTMLElement).style.display = "none"), 300);
                }
            });
        });
    });
</script>
